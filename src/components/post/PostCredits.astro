---
import {PortableText} from 'astro-portabletext'

interface Props {
  credits?: unknown[]
  title: string
}

const {credits, title} = Astro.props
---

{Array.isArray(credits) && credits.length > 0 && (
  <>
    <h2 class="main-title-font text-center text-2xl md:text-3xl font-bold text-[#541409]">
      {title}
    </h2>
    <div class="text-base md:text-xl text-[#220d0c]">
      <PortableText value={credits} />
    </div>
  </>
)}
