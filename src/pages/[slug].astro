---
export const prerender = true;

import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import MainLayout from '../layouts/main.astro';
import Footer from '../components/Footer.astro';
import PostBackLink from '../components/post/PostBackLink.astro';
import PostBody from '../components/post/PostBody.astro';
import PostCredits from '../components/post/PostCredits.astro';
import PostGallery from '../components/post/PostGallery.astro';
import PostVideos from '../components/post/PostVideos.astro';

// This function runs at build time to find all the paths to generate.
export async function getStaticPaths() {
  const SLUGS_QUERY = `*[_type == "post" && defined(slug.current)]{"slug": slug.current}`;
  const slugs = await sanityClient.fetch<Array<{ slug: string }>>(SLUGS_QUERY);
  
  return slugs.map(({ slug }) => {
    return {
      params: { slug: slug }
    };
  });
}

// The code below runs for each generated page.
// Astro passes the `slug` from `getStaticPaths` in `Astro.params`.
const { slug } = Astro.params;

const POST_QUERY = `*[_type == "post" && slug.current == $slug][0]{
  ...,
  "tags": tags[]->name,
  video{
    r2VideoKey,
    r2VideoUrl,
    title,
    posterKey,
    posterUrl,
    caption,
    autoplay,
    makingOfImages[]{
      image,
      alt
    }
  },
  videos[]{
    _type,
    _key,
    r2VideoKey,
    r2VideoUrl,
    title,
    posterKey,
    posterUrl,
    caption,
    autoplay,
    makingOfImages[]{
      image,
      alt
    }
  }
}`;
const post = await sanityClient.fetch<SanityDocument>(POST_QUERY, { slug });
const postVideos = Array.isArray(post.videos) && post.videos.length > 0
  ? post.videos.filter((item: SanityDocument) => item?._type === 'videoWithR2' || item?.r2VideoUrl)
  : post.video
    ? [post.video]
    : [];

// Conditional link logic
const hasAssistingTag = post.tags?.includes('Asistente');
const hasSocialMediaContentTag = post.tags?.includes('Social Media Content SMC');
const backLinkUrl = hasAssistingTag
  ? '/assisting'
  : hasSocialMediaContentTag
    ? '/social-media-content'
    : '/posts';
const backLinkText = hasAssistingTag
  ? 'Todas mis colaboraciones'
  : hasSocialMediaContentTag
    ? 'Todo mi SMC'
    : 'Todos mis proyectos';

// Conditional format for Runways
const isRunway = post.tags?.includes('Pasarela');
const creditsSection = isRunway ? 'Enlaces de Interés' : 'Créditos';
---

<MainLayout title={post.title}>
  <main class="container mx-auto min-h-screen px-4 md:px-8 pt-2 md:pt-4 pb-4 md:pb-8 flex flex-col gap-4 bg-white">
    <PostBackLink href={backLinkUrl} text={backLinkText} />
    <h1>{post.title}</h1>
    <div class="text-center text-2xl md:text-3xl gap-1">
      <p class="title-font text-[#541409] opacity-60">{new Date(post.publishedAt).getFullYear()}</p>
    </div>
    <PostBody body={post.body} />
    <PostVideos videos={postVideos} />
    <PostGallery gallery={post.gallery} />
    <PostCredits credits={post.credits} title={creditsSection} />
    <PostBackLink href={backLinkUrl} text={backLinkText} align="right" />
  </main>
</MainLayout>
<Footer />
